{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/healthz", "destination": "/api/index" },
    { "source": "/readyz", "destination": "/api/index" },
    { "source": "/metrics", "destination": "/api/index" },
    { "source": "/dashboard", "destination": "/api/index" },
    { "source": "/demo/:path*", "destination": "/api/index" },
    { "source": "/v1/:path*", "destination": "/api/index" }
  ]
}
