# SignalMesh local development configuration.
# Copy to .env and adjust. NEVER commit real secrets.

# Runtime
SIGNALMESH_ENV=development
SIGNALMESH_ROLE=all
HOST=0.0.0.0
PORT=8080

# Storage: "json" (default local demo) or "postgres"
SIGNALMESH_STORAGE=json
# Required when SIGNALMESH_STORAGE=postgres (or compose split profile):
# DATABASE_URL=postgres://signalmesh:signalmesh@localhost:5432/signalmesh
SIGNALMESH_DB_HOST=localhost
SIGNALMESH_DB_PORT=5432
SIGNALMESH_DB_NAME=signalmesh
SIGNALMESH_DB_USER=signalmesh
SIGNALMESH_DB_PASSWORD=signalmesh
SIGNALMESH_DB_SSL=false

# Secret handling (REQUIRED in production)
# 32-byte hex key for AES-256-GCM. Generate with: openssl rand -hex 32
SIGNALMESH_SECRET_ENCRYPTION_KEY=
# Pepper for API-key hashing. Generate with: openssl rand -hex 32
SIGNALMESH_API_KEY_PEPPER=

# Limits
SIGNALMESH_MAX_RESPONSE_BYTES=16384
SIGNALMESH_MAX_EVENT_BYTES=262144

# Delivery policy (spec-suggested defaults)
SIGNALMESH_DELIVERY_TIMEOUT_MS=10000
SIGNALMESH_MAX_ATTEMPTS=8
SIGNALMESH_RETRY_BASE_DELAY_MS=2000
SIGNALMESH_RETRY_MAX_DELAY_MS=3600000
SIGNALMESH_WORKER_LEASE_MS=15000

# Worker
SIGNALMESH_WORKER_CONCURRENCY=4
SIGNALMESH_WORKER_POLL_INTERVAL_MS=1000

# Tenant rate limiting
SIGNALMESH_RATE_LIMIT=true
SIGNALMESH_RATE_LIMIT_PER_MINUTE=600
SIGNALMESH_RATE_LIMIT_BURST=120

# Idempotency retention (24h)
SIGNALMESH_IDEMPOTENCY_TTL_MS=86400000

# Dashboard (off by default in production)
SIGNALMESH_ENABLE_DASHBOARD=true

# Fast-demo overrides (uncomment to dead-letter within seconds instead of an hour)
# SIGNALMESH_MAX_ATTEMPTS=3
# SIGNALMESH_RETRY_MAX_DELAY_MS=30000
