{
  "name": "signalmesh",
  "version": "0.1.0",
  "description": "SignalMesh - self-hostable webhook event delivery engine: durable event fan-out, signed deliveries, retries, dead-lettering and replay",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:api": "node src/api.js",
    "start:worker": "node src/worker-main.js",
    "migrate": "node scripts/migrate.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/",
    "test:coverage": "node --test --experimental-test-coverage tests/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,json,yaml,yml}\"",
    "check": "npm run lint && npm run format:check && npm test",
    "vercel:check": "node scripts/vercel-check.js",
    "seed": "node scripts/seed.js",
    "demo:reset": "node scripts/seed.js --reset",
    "demo:seed": "node scripts/seed.js",
    "demo:server": "node scripts/demo-server.js",
    "demo:run": "node scripts/demo.js",
    "smoke": "node scripts/smoke.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0"
  }
}
