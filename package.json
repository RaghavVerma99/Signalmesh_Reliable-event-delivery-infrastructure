{
  "name": "signalmesh",
  "version": "0.1.0",
  "description": "SignalMesh - webhook event delivery engine demo: durable event fan-out, signed deliveries, retries, dead-lettering and replay",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "demo:reset": "node scripts/seed.js --reset",
    "demo:server": "node scripts/demo-server.js",
    "demo:run": "node scripts/demo.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
